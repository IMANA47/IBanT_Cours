<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.gstudent.controller.LoginController">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>

    <Label text="Connexion" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <GridPane hgap="10" vgap="10">
        <Label text="Login :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="tfLogin" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>
        <Label text="Mot de passe :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="pfPassword" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
    <Button text="Se connecter" onAction="#onLogin" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>