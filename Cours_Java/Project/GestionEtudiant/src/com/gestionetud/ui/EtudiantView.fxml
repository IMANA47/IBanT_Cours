<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestionetud.ui.EtudiantController"
            stylesheets="@style.css">

    <!-- ===== EN-TÊTE ===== -->
    <top>
        <VBox styleClass="header-box">
            <Label text="🎓 Gestion des Étudiants" styleClass="header-title"/>
            <Label text="Système de gestion — MariaDB" styleClass="header-subtitle"/>
        </VBox>
    </top>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <VBox spacing="20" styleClass="main-content">
            <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

            <!-- Barre de statut -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="statusLabel" text="Prêt" styleClass="status-label"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="countLabel" text="0 étudiant(s)" styleClass="count-label"/>
            </HBox>

            <!-- ===== FORMULAIRE DE SAISIE ===== -->
            <VBox styleClass="card" spacing="14">
                <Label text="Formulaire étudiant" styleClass="card-title"/>

                <GridPane hgap="16" vgap="12">
                    <!-- Ligne 1 : ID (readonly) + Nom -->
                    <Label text="ID" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                    <TextField fx:id="idEtudiantField" promptText="Auto-généré"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               editable="false" styleClass="field-readonly"/>

                    <Label text="Nom *" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="form-label"/>
                    <TextField fx:id="nomField" promptText="ex: KIMBATSA"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"
                               styleClass="form-field"/>

                    <!-- Ligne 2 : Prénom + Âge -->
                    <Label text="Prénom *" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                    <TextField fx:id="prenomField" promptText="ex: Ange"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               styleClass="form-field"/>

                    <Label text="Âge *" GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="form-label"/>
                    <TextField fx:id="ageField" promptText="ex: 20"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"
                               styleClass="form-field"/>

                    <!-- Colonnes équilibrées -->
                    <columnConstraints>
                        <ColumnConstraints minWidth="70" prefWidth="80"/>
                        <ColumnConstraints minWidth="140" prefWidth="180" hgrow="ALWAYS"/>
                        <ColumnConstraints minWidth="70" prefWidth="80"/>
                        <ColumnConstraints minWidth="140" prefWidth="180" hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>

                <!-- Boutons d'action -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Button fx:id="btnNouveau" text="✚  Nouveau" onAction="#handleNouveau"
                            styleClass="btn-secondary"/>
                    <Button fx:id="btnEnregistrer" text="💾  Enregistrer" onAction="#handleEnregistrer"
                            styleClass="btn-primary"/>
                    <Button fx:id="btnModifier" text="✎  Modifier" onAction="#handleModifier"
                            styleClass="btn-warning" disable="true"/>
                    <Button fx:id="btnSupprimer" text="🗑  Supprimer" onAction="#handleSupprimer"
                            styleClass="btn-danger" disable="true"/>
                    <Button fx:id="btnRafraichir" text="↻  Rafraîchir" onAction="#handleRafraichir"
                            styleClass="btn-info"/>
                </HBox>
            </VBox>

            <!-- ===== TABLEAU DES ÉTUDIANTS ===== -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="10">
                <Label text="Liste des étudiants" styleClass="card-title"/>

                <TableView fx:id="etudiantTable" VBox.vgrow="ALWAYS"
                           onMouseClicked="#handleTableSelection"
                           styleClass="data-table">
                    <columns>
                        <TableColumn fx:id="colIdEtudiant" text="ID" prefWidth="60" sortable="true"/>
                        <TableColumn fx:id="colNom"        text="Nom" prefWidth="180" sortable="true"/>
                        <TableColumn fx:id="colPrenom"     text="Prénom" prefWidth="180" sortable="true"/>
                        <TableColumn fx:id="colAge"        text="Âge" prefWidth="80" sortable="true"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun étudiant enregistré." styleClass="table-placeholder"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

    <!-- ===== BARRE DE STATUT INFÉRIEURE ===== -->
    <bottom>
        <HBox styleClass="footer-bar" alignment="CENTER_LEFT" spacing="16">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            <ProgressIndicator fx:id="progressIndicator" visible="false" prefWidth="18" prefHeight="18"/>
            <Label fx:id="footerLabel" text="Prêt à l'emploi." styleClass="footer-label"/>
        </HBox>
    </bottom>

</BorderPane>
